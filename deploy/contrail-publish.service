# Linux：把 YOURUSER 换成你的用户名，复制到 ~/.config/systemd/user/。
# systemd 单元里 ExecStart 不能用 ~ 或环境变量，只能写绝对路径。

[Unit]
Description=Contrail：发布本机 AI 用量
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
Environment=PATH=/home/YOURUSER/.local/bin:/usr/local/bin:/usr/bin:/bin
Environment=GH_PROMPT_DISABLED=1

# 上一次还没跑完时直接跳过（退出码 75 视为成功），而不是排队叠在一起。
ExecStart=/usr/bin/flock -n -E 75 %t/contrail-publish.lock /home/YOURUSER/contrail/deploy/publish.sh
SuccessExitStatus=75

# 共享服务器：低优先级
Nice=10
IOSchedulingClass=idle

# 首次运行要为 ~/.codex（数 GB）建索引缓存，比较慢；之后几秒钟。
TimeoutStartSec=45min

NoNewPrivileges=true
ProtectSystem=full
